# ─────────────────────────────────────────────────────────────────────────────
#  You normally do NOT need this file.
#
#  All settings (website address, Resend, Google sign-in, company details)
#  are managed in Admin → Settings and stored in <DATA_DIR>/config.env.
#
#  Environment variables with the same names still work as a fallback
#  (values saved in the admin win). Useful ones for the very first start:
# ─────────────────────────────────────────────────────────────────────────────

# First admin account (otherwise: username "admin" + random password in the logs)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-long-password

# Where the database, uploads and config.env are stored (Docker: /app/data)
# DATA_DIR=./data

# Defaults to https://catalog.luxiko.be — can be changed in the admin
# SITE_URL=https://catalog.luxiko.be
