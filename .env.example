# ─────────────────────────────────────────────────────────────────────────────
#  LUXIKO catalog — secrets & settings
#
#  1. Copy this file to  .env.local   (cp .env.example .env.local)
#  2. Fill in the values below.
#  3. Restart the app.
#
#  .env.local is listed in .gitignore, so it is never committed or uploaded
#  to GitHub. Keep it private (chmod 600 .env.local on a server).
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the website, without trailing slash.
# The QR codes in the PDF point to  <SITE_URL>/p/<PRODUCT CODE>
SITE_URL=https://catalog.luxiko.be

# Random secret used to sign admin login sessions (at least 32 characters).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# ── Google sign-in (admin) ───────────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type:        Web application
#   Authorised redirect URI: <SITE_URL>/api/auth/callback
#                            (and http://localhost:3000/api/auth/callback for testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts that may open the admin, comma separated.
ADMIN_EMAILS=you@example.com

# ── Resend (quote request e-mails) ───────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. The domain must be verified in Resend.
MAIL_FROM="LUXIKO <offerte@luxiko.be>"
# Where new quote requests are delivered (comma separated for several people).
QUOTE_TO_EMAIL=info@luxiko.be

# ── Company details (shown on the website and on the PDF back cover) ────────
COMPANY_NAME=LUXIKO
COMPANY_EMAIL=info@luxiko.be
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_VAT=

# Where the database and uploaded files are stored. Back this folder up.
DATA_DIR=./data
